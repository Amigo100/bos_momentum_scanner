# Sterling Signals - Environment Variables
# =========================================
# Copy this file to .env and fill in your credentials
# DO NOT commit .env to git (it's in .gitignore)

# Required: Anthropic API for LLM analysis
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Required for Twitter posting (3 accounts)
# Account 1: @AlexSterlingGBR (main)
X1_API_KEY=your-x1-api-key
X1_API_SECRET=your-x1-api-secret
X1_ACCESS_TOKEN=your-x1-access-token
X1_ACCESS_SECRET=your-x1-access-secret

# Account 2: @Rdobrogowska
X2_API_KEY=your-x2-api-key
X2_API_SECRET=your-x2-api-secret
X2_ACCESS_TOKEN=your-x2-access-token
X2_ACCESS_SECRET=your-x2-access-secret

# Account 3
X3_API_KEY=your-x3-api-key
X3_API_SECRET=your-x3-api-secret
X3_ACCESS_TOKEN=your-x3-access-token
X3_ACCESS_SECRET=your-x3-access-secret

# Optional: TradingView layout ID for chart capture
# TRADINGVIEW_LAYOUT_ID=rxC5j0SK

# Optional: Email notifications
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# EMAIL_SENDER=your.email@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_RECIPIENTS=recipient@email.com
