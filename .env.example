# Sterling Signals - Environment Variables
# =========================================
# Copy this file to .env and fill in your credentials
# DO NOT commit .env to git (it's in .gitignore)

# Required: Anthropic API for LLM analysis
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Required for Twitter posting
X_API_KEY=your-x-api-key
X_API_SECRET=your-x-api-secret
X_ACCESS_TOKEN=your-access-token
X_ACCESS_SECRET=your-access-secret

# Optional: TradingView layout ID for chart capture
# TRADINGVIEW_LAYOUT_ID=rxC5j0SK

# Optional: Email notifications
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# EMAIL_SENDER=your.email@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_RECIPIENTS=recipient@email.com
