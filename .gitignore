# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/

# OS
.DS_Store
Thumbs.db

# Logs (keep structure, ignore contents)
logs/*.log
logs/*.txt

# IDE
.vscode/
.idea/
*.swp

# Local settings
.claude/

# Data files that change frequently
data/themes_cache.json

# Playwright browser profile (contains login sessions)
.playwright_profile/

# TradingView authentication cookies (SENSITIVE)
.tradingview_cookies.json

# Sensitive backup copies
*.bak
*copy*.txt

# Local environment files
.env
.env.local

# Reports directory (generated, can be large)
reports/

# Legacy trades/ directory (replaced by section-specific output dirs)
trades/

# Section output directories (generated data, not source code)
portfolio/output/
scanner/output/*
substack/output/*
twitter/output/

# Exceptions: files needed by Saturday workflow (GitHub Actions)
!scanner/output/decisions.json
!scanner/output/signal_history_rows.csv
!substack/output/current/
substack/output/current/*
!substack/output/current/newsletter.html

# Dashboard bundled data (generated at build time)
dashboard/data/

# Chart images committed for tweet posting pipeline
# (small files ~50-100KB, needed by daily_post workflow)

# Git worktrees
.worktrees/
